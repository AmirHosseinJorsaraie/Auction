@page "/operations"
@inject AdminApiClient Api
<PageTitle>عملیات فروش و پرداخت</PageTitle>
<header class="page-heading"><div><span class="eyebrow">نظارت تجاری</span><h1>آثار، سفارش‌ها و پرداخت</h1><p>داده عملیاتی کمینه نمایش داده می‌شود؛ نشانی و اطلاعات خصوصی خریدار در این نما وجود ندارد.</p></div></header>
@if(Notice=="saved"){<div class="alert alert-success" role="status">عملیات با موفقیت ثبت شد.</div>}@if(QueryError is not null){<div class="alert alert-danger" role="alert">@QueryError</div>}
@if(Error is not null){<div class="alert alert-danger" role="alert">@Error</div>}else if(Catalog is null){<p>در حال بارگذاری…</p>}else{
<section class="panel"><h2>عرضه‌های اخیر</h2><div class="table-responsive"><table class="table admin-table"><caption>عرضه‌های اخیر و وضعیت انتشار</caption><thead><tr><th>شناسه عرضه</th><th>مبلغ</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>@foreach(var row in Catalog.Items){<tr><td dir="ltr">@row.Id</td><td>@row.PriceAmount.ToString("N0") @row.Currency</td><td><span class="status-pill">@row.Status</span></td><td>@if(row.Status=="Published"){<details><summary class="btn btn-sm btn-outline-warning">تعلیق</summary><form class="operation-form" method="post" action="/operations/listings/@row.Id/suspend"><AntiforgeryToken/><label>دلیل<input class="form-control" name="reason" minlength="3" maxlength="1000" required/></label><button class="btn btn-warning">تأیید تعلیق</button></form></details>}</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>سفارش‌های اخیر</h2>@if(Orders?.Items.Count==0){<div class="empty-state">سفارشی وجود ندارد.</div>}else if(Orders is not null){<div class="table-responsive"><table class="table admin-table"><caption>سفارش‌های اخیر و وضعیت توقف عملیاتی</caption><thead><tr><th>سفارش</th><th>مبلغ</th><th>وضعیت</th><th>Hold</th></tr></thead><tbody>@foreach(var row in Orders.Items){<tr><td dir="ltr">@row.Id</td><td>@row.TotalAmount.ToString("N0") @row.Currency</td><td>@row.Status</td><td>@(row.ReviewIntegrityHold||row.SellerEligibilityHold?"فعال":"—")</td></tr>}</tbody></table></div>}</section>
<section class="panel"><h2>تلاش‌های پرداخت</h2>@if(Payments?.Items.Count==0){<div class="empty-state">تلاش پرداختی وجود ندارد.</div>}else if(Payments is not null){<div class="table-responsive"><table class="table admin-table"><caption>تلاش‌های پرداخت اخیر و خطاها</caption><thead><tr><th>پرداخت</th><th>سفارش</th><th>وضعیت</th><th>خطا</th></tr></thead><tbody>@foreach(var row in Payments.Items){<tr><td dir="ltr">@row.Id</td><td dir="ltr">@row.OrderId</td><td>@row.Status</td><td dir="ltr">@(row.FailureCode??"—")</td></tr>}</tbody></table></div>}</section>}
@if(Reconciliations is not null){<section class="panel"><h2>مغایرت‌های پرداخت</h2>@if(Reconciliations.Count==0){<div class="empty-state">مغایرت بازی وجود ندارد.</div>}else{<div class="table-responsive"><table class="table admin-table"><caption>مغایرت‌های پرداخت نیازمند بررسی</caption><thead><tr><th>سفارش</th><th>کد</th><th>شرح</th><th>وضعیت</th></tr></thead><tbody>@foreach(var row in Reconciliations){<tr><td dir="ltr">@row.OrderId</td><td dir="ltr">@row.ReasonCode</td><td>@row.Details</td><td>@row.Status</td></tr>}</tbody></table></div>}</section>}
@code{[SupplyParameterFromQuery]public string? Notice{get;set;}[SupplyParameterFromQuery(Name="error")]public string? QueryError{get;set;}private PagedResponse<CatalogRow>? Catalog;private PagedResponse<OrderMonitorRow>? Orders;private PagedResponse<PaymentMonitorRow>? Payments;private IReadOnlyList<ReconciliationRow>? Reconciliations;private string? Error;protected override async Task OnInitializedAsync(){try{Catalog=await Api.CatalogAsync(1,CancellationToken.None);Orders=await Api.OrdersAsync(1,CancellationToken.None);Payments=await Api.PaymentsAsync(1,CancellationToken.None);Reconciliations=await Api.ReconciliationsAsync(CancellationToken.None);}catch(Exception ex){Error=$"دریافت اطلاعات عملیاتی ناموفق بود: {ex.Message}";}}}
