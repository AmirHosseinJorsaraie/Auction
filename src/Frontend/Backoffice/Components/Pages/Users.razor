@page "/users"
@inject AdminApiClient Api
<PageTitle>کاربران و نقش‌ها</PageTitle>
<header class="page-heading"><div><span class="eyebrow">دسترسی و هویت</span><h1>کاربران و نقش‌ها</h1><p>عملیات حساس فقط با دلیل ثبت‌شده، MFA و audit انجام می‌شود.</p></div></header>
@if(Notice == "saved") { <div class="alert alert-success" role="status">تغییر با موفقیت ثبت شد.</div> }
@if(QueryError is not null) { <div class="alert alert-danger" role="alert">@QueryError</div> }
<form class="filter-bar" method="get"><label for="search">جست‌وجوی ایمیل یا نام</label><input id="search" name="search" class="form-control" value="@Search" /><button class="btn btn-primary">جست‌وجو</button></form>
@if (Error is not null) { <div class="alert alert-danger" role="alert">@Error</div> }
else if (Data is null) { <p aria-live="polite">در حال بارگذاری…</p> }
else if (Data.Items.Count == 0) { <div class="empty-state">کاربری مطابق فیلتر پیدا نشد.</div> }
else { <div class="table-responsive"><table class="table admin-table"><caption>فهرست کاربران؛ صفحه @Data.Page</caption><thead><tr><th>کاربر</th><th>وضعیت</th><th>نقش‌ها</th><th>عملیات</th></tr></thead><tbody>@foreach(var user in Data.Items){<tr><td><strong>@(user.DisplayName ?? "بدون نام")</strong><small dir="ltr">@user.Email</small></td><td><span class="status-pill @(user.IsEnabled?"ok":"danger")">@(user.IsEnabled?"فعال":"غیرفعال")</span><small>MFA: @(user.TwoFactorEnabled?"فعال":"غیرفعال")</small></td><td>@string.Join("، ", user.Roles)</td><td><details><summary class="btn btn-sm btn-outline-dark">مدیریت</summary><form method="post" action="/operations/users/@user.Id/status" class="operation-form"><AntiforgeryToken/><input type="hidden" name="enabled" value="@(!user.IsEnabled).ToString().ToLowerInvariant()"/><label>دلیل<input class="form-control" name="reason" minlength="3" maxlength="1000" required /></label><button class="btn btn-warning">@(user.IsEnabled?"غیرفعال‌سازی":"فعال‌سازی")</button></form><AuthorizeView Policy="@MarketplacePolicies.RolesManage"><Authorized><form method="post" action="/operations/users/@user.Id/role" class="operation-form"><AntiforgeryToken/><label>نقش<select class="form-select" name="role"><option>User</option><option>Expert</option><option>Admin</option><option>SuperAdmin</option></select></label><label>دلیل<input class="form-control" name="reason" minlength="3" required /></label><button class="btn btn-outline-primary" name="assign" value="true">افزودن</button><button class="btn btn-outline-danger" name="assign" value="false">حذف</button></form></Authorized></AuthorizeView></details></td></tr>}</tbody></table></div> }
@code { [SupplyParameterFromQuery] public string? Search {get;set;} [SupplyParameterFromQuery] public string? Notice {get;set;} [SupplyParameterFromQuery(Name="error")] public string? QueryError {get;set;} private PagedResponse<UserRow>? Data; private string? Error; protected override async Task OnParametersSetAsync(){try{Data=await Api.UsersAsync(1,Search,CancellationToken.None);}catch(Exception ex){Error=$"دریافت کاربران ناموفق بود: {ex.Message}";}} }
