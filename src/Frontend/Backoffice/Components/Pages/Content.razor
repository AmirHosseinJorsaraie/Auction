@page "/content"
@inject AdminApiClient Api
<PageTitle>دسته‌بندی و محتوا</PageTitle>
<header class="page-heading"><div><span class="eyebrow">مدیریت محتوا</span><h1>دسته‌بندی‌ها و صفحات اطلاع‌رسانی</h1><p>محتوای محدود و کنترل‌شده؛ بدون HTML خام یا script.</p></div></header>
@if(Notice=="saved"){<div class="alert alert-success" role="status">محتوا با موفقیت ذخیره شد.</div>}@if(QueryError is not null){<div class="alert alert-danger" role="alert">@QueryError</div>}
@if(Error is not null){<div class="alert alert-danger" role="alert">@Error</div>}
<div class="two-column"><section class="panel"><h2>دسته‌بندی جدید</h2><form method="post" action="/operations/categories" class="stack-form"><AntiforgeryToken/><label>نام<input class="form-control" name="name" maxlength="120" required/></label><label>slug<input dir="ltr" class="form-control" name="slug" maxlength="120" pattern="[a-z0-9-]+" required/></label><label>ترتیب<input class="form-control" type="number" name="displayOrder" value="0"/></label><button class="btn btn-primary">ذخیره دسته‌بندی</button></form>@if(Categories is not null){<ul class="clean-list">@foreach(var item in Categories){<li><strong>@item.Name</strong><span dir="ltr">@item.Slug</span><span class="status-pill">@(item.IsActive?"فعال":"غیرفعال")</span></li>}</ul>}</section><section class="panel"><h2>صفحه جدید</h2><form method="post" action="/operations/content/pages" class="stack-form"><AntiforgeryToken/><label>عنوان<input class="form-control" name="title" maxlength="200" required/></label><label>slug<input dir="ltr" class="form-control" name="slug" maxlength="120" pattern="[a-z0-9-]+" required/></label><label>متن<textarea class="form-control" name="body" maxlength="10000" rows="6" required></textarea></label><label><input type="checkbox" name="isPublished" value="true"/> انتشار فوری</label><button class="btn btn-primary">ذخیره صفحه</button></form>@if(Pages is not null){<ul class="clean-list">@foreach(var item in Pages){<li><strong>@item.Title</strong><span dir="ltr">/@item.Slug</span><span class="status-pill">@(item.IsPublished?"منتشر":"پیش‌نویس")</span></li>}</ul>}</section></div>
@code{[SupplyParameterFromQuery]public string? Notice{get;set;}[SupplyParameterFromQuery(Name="error")]public string? QueryError{get;set;}private IReadOnlyList<CategoryRow>? Categories;private IReadOnlyList<ContentPageRow>? Pages;private string? Error;protected override async Task OnInitializedAsync(){try{Categories=await Api.CategoriesAsync(CancellationToken.None);Pages=await Api.ContentPagesAsync(CancellationToken.None);}catch(Exception ex){Error=$"دریافت محتوا ناموفق بود: {ex.Message}";}}}
