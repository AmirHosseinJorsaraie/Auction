@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span>پنل امن کارکنان</span><form method="post" action="/auth/logout"><AntiforgeryToken/><button class="btn btn-sm btn-outline-dark">خروج</button></form>
        </div>

        <article id="main-content" class="content px-4" tabindex="-1">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری دوباره</a>
    <span class="dismiss">🗙</span>
</div>
