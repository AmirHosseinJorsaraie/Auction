  "components": {
    "schemas": {
      "AddressRequest": {
        "required": [
          "label",
          "recipientName",
          "addressLine",
          "postalCode"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "recipientName": {
            "type": "string"
          },
          "addressLine": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          }
        }
      },
      "AnnotationRequest": {
        "required": [
          "message",
          "sellerVisible"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "sellerVisible": {
            "type": "boolean"
          }
        }
      },
      "ArtworkDraftRequest": {
        "required": [
          "title",
          "artistAttribution",
          "description",
          "categoryId",
          "year",
          "medium",
          "dimensions",
          "condition"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "artistAttribution": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "medium": {
            "type": "string"
          },
          "dimensions": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          }
        }
      },
      "CategoryRequest": {
        "required": [
          "name",
          "slug",
